  RewriteRule ^bmw-r1200gs\.html$ /models/bmw/r-1200-gs.html [R=302,L,NC]
  RewriteRule ^bmw-r1200rt\.html$ /models/bmw/r-1200-rt.html [R=302,L,NC]
  RewriteRule ^bmw-r1250gs\.html$ /models/bmw/r-1250-gs.html [R=302,L,NC]
  RewriteRule ^bmw-r1250r\.html$ /models/bmw/r-1250-r.html [R=302,L,NC]
