# AnyBike public site: revalidate pages and shared scripts when revisited.
# Apache / 123-reg hosting. Keep pages fresh without disabling browser storage
# used by Supabase authentication.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always unset Expires
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always unset Expires
  </FilesMatch>
</IfModule>

# Search Console legacy URL recovery (3 Nov 2026).
# Exact-match redirects only: preserve the rest of /markets/ and private routes.
# Apache mod_alias normally forwards the original query string when the target has none.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/contact-us[.]html$ /anybike-connect.html
  RedirectMatch 301 ^/request-a-bike[.]html$ /buy-motorcycles.html
  RedirectMatch 301 ^/sell-your-bike[.]html$ /sell-your-motorcycle.html
  RedirectMatch 301 ^/italy[.]html$ /markets/italy.html
  RedirectMatch 301 ^/belgium[.]html$ /markets/belgium.html
  RedirectMatch 301 ^/australia[.]html$ /markets/australia.html
  RedirectMatch 301 ^/markets/?$ /international-markets.html
</IfModule>

# Search Console: narrowly scoped legacy /motorcycles/category/manufacturer URL fixes.
# Do not rewrite live inventory, private accounts, current model URLs, or generic /motorcycles/ paths.
# Explicit manufacturer query values avoid inheriting broken page=1&&&& crawl parameters.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^motorcycles/sale-your-motorcycle/suzuki/?$ /sell-your-motorcycle.html?make=Suzuki [R=301,L,NC,NE]
  RewriteRule ^motorcycles/sale-your-motorcycle/zero-\(electric\)/?$ /sell-your-motorcycle.html?make=Zero+Motorcycles [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/ducati/?$ /motorcycle-brand.html?make=Ducati [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/royal-enfield/?$ /motorcycle-brand.html?make=Royal+Enfield [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/bmw/?$ /bmw-motorcycles.html [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/kawasaki/?$ /motorcycle-brand.html?make=Kawasaki [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/triumph/?$ /motorcycle-brand.html?make=Triumph [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/zero-\(electric\)/?$ /motorcycle-brand.html?make=Zero+Motorcycles [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/piaggio/?$ /motorcycle-brand.html?make=Piaggio [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/yamaha/?$ /motorcycle-brand.html?make=Yamaha [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/honda/?$ /motorcycle-brand.html?make=Honda [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/ktm/?$ /motorcycle-brand.html?make=KTM [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/harley-davidson/?$ /harley-davidson-motorcycles.html [R=301,L,NC,NE]
  RewriteRule ^motorcycles/(?:used-motorcycles|online-bikes|buy-scooter-bike|used-scooters|bikes-for-sale|motorcycles-dealers|buying|second-hand-motorcycles|UK-motorcycles|search-motorcycles|motorcycles-for-sale)/suzuki/?$ /motorcycle-brand.html?make=Suzuki [R=301,L,NC,NE]
</IfModule>

# Keep login and registration return-URL variants out of Google search.
# Header-only directive; no change to customer authentication or redirects.
<IfModule mod_headers.c>
  <FilesMatch "^(customer-login|customer-register)[.]html$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>
