<script>
const SUPABASE_URL = "https://tuehtnezhdnkqbbhttgp.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_mrkBKDxEPVmdj2n7gPWsbg_l4CShtcK";
const sb = supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);

const currencyRates = {
  GBP:1,
  EUR:1.17,
  USD:1.27,
  AUD:1.93,
  NZD:2.10,
  CAD:1.73,
  AED:4.66
};

function escapeHtml(value){
  return String(value ?? "").replace(/[&<>"']/g,function(char){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char];
  });
}

function currentCurrency(){
  return localStorage.getItem("anybikeCurrency") ||
         localStorage.getItem("anybike_currency") ||
         "AUD";
}

function money(gbp){
  const value = Number(gbp);
  if(!Number.isFinite(value) || value <= 0) return "POA";

  const currency = currentCurrency();
  const rate = currencyRates[currency] || 1;

  return (value * rate).toLocaleString("en-AU",{
    style:"currency",
    currency:currency,
    maximumFractionDigits:0
  });
}

async function loadStock(){
  const grid = document.getElementById("stockGrid");

  try{
    const {data,error} = await sb
      .from("available_stock")
      .select("id,make,model,variant,year,mileage,price_gbp,image_url,status,created_at")
      .not("make","is",null)
      .not("model","is",null)
      .order("created_at",{ascending:false})
      .limit(8);

    if(error) throw error;

    if(!data || !data.length){
      grid.innerHTML = '<div class="loading">No motorcycles are currently available.</div>';
      return;
    }

    grid.innerHTML = data.slice(0,4).map(function(bike){
      const title = [bike.year,bike.make,bike.model,bike.variant]
        .filter(Boolean)
        .join(" ");

      const mileage = Number(bike.mileage);
      const mileageText = Number.isFinite(mileage) && mileage > 0
        ? mileage.toLocaleString("en-GB") + " miles"
        : "Mileage available on request";

      return `
        <a class="stock-card" href="/bike-details.html?id=${encodeURIComponent(bike.id)}">
          <img
            src="${escapeHtml(bike.image_url || "/anybike-logo-new.jpg")}"
            alt="${escapeHtml(title)}"
            loading="lazy"
            onerror="this.src='/anybike-logo-new.jpg';"
          >
          <div class="stock-copy">
            <h3>${escapeHtml(title)}</h3>
            <div class="stock-meta">${escapeHtml(mileageText)}</div>
            <div class="stock-price">${escapeHtml(money(bike.price_gbp))}</div>
          </div>
        </a>
      `;
    }).join("");

  }catch(error){
    console.warn("Available stock could not be loaded",error);
    grid.innerHTML = '<div class="loading">Available stock could not be loaded.</div>';
  }
}

window.addEventListener("anybikeCurrencyChanged",loadStock);

document.addEventListener("DOMContentLoaded",function(){
  loadStock();
});
</script>

